# Docker 镜像标签
API_TAG=1.26.0727
TAG=1.26.0727

# Nuxt 服务端口（Docker 容器内）
PORT=7200

# API 代理地址（推荐使用 NUXT_API_URL，兼容旧变量 NUXT_ENV_API_URL）
NUXT_API_URL=https://api.mmxiaowu.com
# NUXT_ENV_API_URL=https://api.mmxiaowu.com
# 本地 Docker 网络内示例: NUXT_API_URL=http://api:4000

# 公开上传接口（可选）
# NUXT_PUBLIC_UPLOAD_API=https://php.mmxiaowu.com

# MongoDB 数据目录（docker-compose）
MONGO_DIR=./data/mongodb
